{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "jsx": "react-jsx",

    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,

    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["react", "react-dom"]
  },
  "include": ["src"]
}
